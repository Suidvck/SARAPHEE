# ========================================================
# SARAPHEE ENVIRONMENT CONFIGURATION
# คัดลอกไฟล์นี้ไปเป็น .env แล้วกรอกข้อมูลจริง
# ========================================================

# Port สำหรับ Web Server (Render จะสุ่มให้เองอัตโนมัติ ในเครื่องใช้ 3001)
PORT=3001

# ========================================================
# 1. SUPABASE (ฐานข้อมูลหลักของระบบ)
# หาได้จาก https://supabase.com/dashboard -> Project Settings -> API
# ========================================================
# Project URL เช่น https://abcdefghijklm.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# ใช้ service_role secret key (แนะนำสำหรับบอทและ backend เพราะเขียนได้ทุกตาราง)
# หรือ anon public key
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# ========================================================
# 2. DISCORD BOT & GUILD
# หาได้จาก https://discord.com/developers/applications
# ========================================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_server_id_here

# ========================================================
# 3. DISCORD CHANNELS (ทางเลือก สำหรับส่งแจ้งเตือน/Log เข้าห้อง)
# ถ้าไม่ใส่ บอทยังคงใช้งานคำสั่ง Slash Commands จัดการ Supabase ได้ 100%
# ========================================================
DISCORD_CHANNEL_ANNOUNCEMENTS=
DISCORD_CHANNEL_CHEER_WALL=
DISCORD_CHANNEL_MATCHES=
DISCORD_CHANNEL_ROSTER=
DISCORD_CHANNEL_REGISTRATIONS=
DISCORD_CHANNEL_SCORES=

# ========================================================
# 4. FRONTEND VITE (สำหรับหน้าเว็บตอน build / dev)
# ========================================================
VITE_API_BASE_URL=https://saraphee.onrender.com
