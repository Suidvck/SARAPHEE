# ========================================================
# SARAPHEE ENVIRONMENT CONFIGURATION
# คัดลอกไฟล์นี้ไปเป็น .env แล้วกรอกข้อมูลจริง
# ========================================================

# Port สำหรับ Web Server (Render จะสุ่มให้เองอัตโนมัติ ในเครื่องใช้ 3001)
PORT=3001

# ========================================================
# 1. SUPABASE (ฐานข้อมูลหลักของระบบ)
# หาได้จาก https://supabase.com/dashboard -> Project Settings -> API
# ========================================================
# การเชื่อมต่อ PostgreSQL (สำคัญมากสำหรับ Render)
# ใช้ "Session pooler" ห้ามใช้ direct connection เพราะ
# direct host (db.<ref>.supabase.co) เป็น IPv6-only และ Render ต่อไม่ได้
# เจาะลึก: หาได้จาก Dashboard -> Project Settings -> Database -> Connection string
# รูปแบบ: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Project URL เช่น https://abcdefghijklm.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# REST API key ใช้เป็นตัวสำรอง ถ้า DATABASE_URL ต่อไม่ได้
# รูปแบบปัจจุบันของ Supabase ขึ้นต้นด้วย sb_publishable_ หรือ sb_secret_
# (service_role แบบเก่าไม่ต้องใส่ Bearer token ถ้าใช้ key แบบใหม่ ให้ส่งผ่าน apikey header อย่างเดียว)
SUPABASE_KEY=

# ========================================================
# 2. DISCORD BOT & GUILD
# หาได้จาก https://discord.com/developers/applications
# ========================================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_server_id_here

# ========================================================
# 3. DISCORD CHANNELS (ทางเลือก สำหรับส่งแจ้งเตือน/Log เข้าห้อง)
# ถ้าไม่ใส่ บอทยังคงใช้งานคำสั่ง Slash Commands จัดการ Supabase ได้ 100%
# ========================================================
DISCORD_CHANNEL_ANNOUNCEMENTS=
DISCORD_CHANNEL_CHEER_WALL=
DISCORD_CHANNEL_MATCHES=
DISCORD_CHANNEL_ROSTER=
DISCORD_CHANNEL_REGISTRATIONS=
DISCORD_CHANNEL_SCORES=

# ========================================================
# 4. FRONTEND VITE (สำหรับหน้าเว็บตอน build / dev)
# ========================================================
VITE_API_BASE_URL=https://saraphee.onrender.com
